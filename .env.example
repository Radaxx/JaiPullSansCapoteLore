# Token du bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=
# IA utilisée pour écrire : gemini (gratuit, par défaut), groq (gratuit), ollama (gratuit, local) ou claude (payant)
AI_PROVIDER=gemini
# Clé gratuite Gemini : https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Clé gratuite Groq : https://console.groq.com/keys
GROQ_API_KEY=
# Clé Claude, seulement si AI_PROVIDER=claude
ANTHROPIC_API_KEY=
# Optionnel : forcer un modèle précis (sinon : modèle par défaut du fournisseur)
AI_MODEL=
# Nom de la guilde et royaume WoW, utilisés par le Chroniqueur
GUILD_NAME="J'ai pull sans protection"
WOW_REALM=Hyjal
# Serveur Discord de la guilde (commandes disponibles immédiatement)
DEV_GUILD_ID=1569153457204633740
# Salon où les nouveaux chapitres sont publiés
LORE_CHANNEL_ID=1574017730900791376
# Faits établis de la saga, et noms à ne jamais écrire (séparés par des virgules)
LORE_CANON_PATH=lore_canon.md
LORE_FORBIDDEN_NAMES=Violette
# Fichier de la base SQLite
LORE_DB_PATH=lore.db
LORE_PROLOGUE_PATH=prologue.md
